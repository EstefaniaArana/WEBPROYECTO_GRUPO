@model AerolineaVIP_MVC.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
    bool enviado = ViewBag.Enviado != null;
}

<h1 class="h2">Recuperar acceso</h1>
<p>Ingrese el correo o nombre de usuario asociado a su cuenta.</p>

@if (enviado)
{
    <div class="alert alert-info" role="status">
        Si los datos corresponden a una cuenta registrada, recibirá las instrucciones para recuperar el acceso.
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning" role="alert">@Html.ValidationSummary(true)</div>
}

@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "formRecuperar" }))
{
    @Html.AntiForgeryToken()
    <div class="mb-3" style="max-width:480px;">
        @Html.LabelFor(m => m.Identificador, "Correo o nombre de usuario *", new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Identificador, new { @class = "form-control", maxlength = 256, autocomplete = "username" })
        @Html.ValidationMessageFor(m => m.Identificador, "", new { @class = "text-danger small" })
    </div>
    <button type="submit" class="btn btn-primary" id="btnSolicitar">Solicitar recuperación</button>
    @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", null, new { @class = "btn btn-outline-secondary" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $('#formRecuperar').on('submit', function () {
                if ($(this).valid()) { $('#btnSolicitar').prop('disabled', true).text('Enviando solicitud…'); }
            });
            $(window).on('pageshow', function () { $('#btnSolicitar').prop('disabled', false).text('Solicitar recuperación'); });
        });
    </script>
}
@model AerolineaVIP_MVC.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Nueva contraseña";
    bool listo = ViewBag.Listo != null;
}

<h1 class="h2">Nueva contraseña</h1>

@if (listo)
{
    <div class="alert alert-success" role="status">Su contraseña fue cambiada. Ya puede iniciar sesión.</div>
    @Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "btn btn-primary" })
}
else
{
    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">@Html.ValidationSummary(true)</div>
    }

    using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "formReset" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.UserId)
        @Html.HiddenFor(m => m.Code)

        <div class="mb-3" style="max-width:480px;">
            @Html.LabelFor(m => m.Password, "Nueva contraseña *", new { @class = "form-label" })
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", aria_describedby = "ayudaClave" })
            <div id="ayudaClave" class="form-text">Mínimo 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.</div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
        </div>
        <div class="mb-3" style="max-width:480px;">
            @Html.LabelFor(m => m.ConfirmPassword, "Confirmar contraseña *", new { @class = "form-label" })
            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
        </div>
        <button type="submit" class="btn btn-primary" id="btnCambiar">Cambiar contraseña</button>
    }
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $('#formReset').on('submit', function () {
                if ($(this).valid()) { $('#btnCambiar').prop('disabled', true).text('Guardando…'); }
            });
        });
    </script>
}
@model AerolineaVIP_MVC.Models.Aeronave

<div class="form-group">
    <label class="control-label col-md-2">Matrícula</label>
    <div class="col-md-4">
        @Html.TextBoxFor(m => m.Matricula, new { @class = "form-control", maxlength = 15 })
        @Html.ValidationMessageFor(m => m.Matricula, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <label class="control-label col-md-2">Modelo</label>
    <div class="col-md-4">
        @Html.DropDownListFor(m => m.ModeloAeronaveId, (SelectList)ViewBag.ListaModelos, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ModeloAeronaveId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <label class="control-label col-md-2">Estado</label>
    <div class="col-md-4">
        @Html.DropDownListFor(m => m.EstadoAeronaveCodigo, (SelectList)ViewBag.ListaEstados, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.EstadoAeronaveCodigo, "", new { @class = "text-danger" })
    </div>
</div>

@model AerolineaVIP_MVC.Controllers.ComprobanteVista
@{
    ViewBag.Title = "Comprobante " + Model.Numero;
}

@* Al imprimir se ocultan el menú, los botones y el pie *@
<style>
    @@media print {
        .navbar, .no-imprimir, footer, hr {
            display: none !important;
        }

        body {
            padding-top: 0 !important;
        }
    }
</style>

<h1 class="h2 no-imprimir">Vista previa del comprobante</h1>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h4">@Model.EmisorNombre</h2>
        <p class="mb-1">Identificación: @Model.EmisorIdentificacion</p>
        <p class="mb-3">Dirección: @Model.EmisorDireccion</p>

        <h3 class="h5">@Model.Tipo N.º @Model.Numero</h3>
        <dl class="row mb-3">
            <dt class="col-sm-3">Fecha de emisión</dt>
            <dd class="col-sm-9">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>
            <dt class="col-sm-3">Reserva</dt>
            <dd class="col-sm-9">@Model.CodigoReserva · compra @Model.EstadoCompra.ToLower()</dd>
            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.Cliente</dd>
            <dt class="col-sm-3">Pago simulado</dt>
            <dd class="col-sm-9">@Model.Pago</dd>
        </dl>

        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Pasajero</th><th>Vuelo</th><th>Asiento</th><th class="text-end">Importe (@Model.Moneda)</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Lineas)
                    {
                        <tr><td>@l.Pasajero</td><td>@l.Vuelo</td><td>@l.Asiento</td><td class="text-end">@l.Importe.ToString("N2")</td></tr>
                    }
                </tbody>
                <tfoot><tr><th colspan="3">Total</th><th class="text-end">@Model.Total.ToString("N2") @Model.Moneda</th></tr></tfoot>
            </table>
        </div>

        <p class="text-muted small mb-0">@Model.Leyenda</p>
    </div>
</div>

<div class="no-imprimir d-flex flex-wrap gap-2">
    @Html.ActionLink("Descargar PDF", "Descargar", "Comprobantes", new { id = Model.ComprobanteId }, new { @class = "btn btn-primary" })
    <button type="button" class="btn btn-outline-primary" onclick="window.print();">Imprimir</button>
    @Html.ActionLink("Volver a comprobantes", "Index", "Comprobantes", null, new { @class = "btn btn-outline-secondary" })
</div>

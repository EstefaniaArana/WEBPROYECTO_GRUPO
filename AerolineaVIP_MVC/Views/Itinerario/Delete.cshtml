@model AerolineaVIP_MVC.Models.Itinerario
@{
    ViewBag.Title = "Eliminar itinerario";
}

<h2>Eliminar itinerario</h2>
<h4>¿Seguro que desea eliminar este itinerario?</h4>

<dl class="dl-horizontal">
    <dt>Referencia</dt>
    <dd>@Model.Referencia</dd>
    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>
    <dt>Estado</dt>
    <dd>@Model.EstadoItinerarioCodigo</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
}
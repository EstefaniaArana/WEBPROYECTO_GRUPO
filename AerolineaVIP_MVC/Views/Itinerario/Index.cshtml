@model IEnumerable<AerolineaVIP_MVC.Models.Itinerario>
@{
    ViewBag.Title = "Itinerarios";
    var cantidad = (Dictionary<int, int>)ViewBag.Cantidad;
}

<h2>Itinerarios</h2>

@if (TempData["Error"] != null)
{<div class="alert alert-danger">@TempData["Error"]</div>}
@if (ViewBag.Error != null)
{<div class="alert alert-danger">@ViewBag.Error</div>}

<p>@Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })</p>

@* FILTROS: texto y estado (lista desplegable) *@
@using (Html.BeginForm("Index", "Itinerario", FormMethod.Get, new { @class = "form-inline" }))
{
    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Referencia o nombre" />
    @Html.DropDownList("estado", (SelectList)ViewBag.Estados, "-- Todos --", new { @class = "form-control" })
    <input type="submit" value="Filtrar" class="btn btn-default" />
    @Html.ActionLink("Limpiar", "Index", null, new { @class = "btn btn-link" })
}
<br />

<table class="table table-striped">
    <tr>
        <th>Referencia</th>
        <th>Nombre</th>
        <th>Estado</th>
        <th>Tramos</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Referencia</td>
            <td>@item.Nombre</td>
            <td>@item.EstadoItinerarioCodigo</td>
            <td>@(cantidad.ContainsKey(item.ItinerarioId) ? cantidad[item.ItinerarioId] : 0)</td>
            <td>
                @Html.ActionLink("Tramos", "Tramos", new { id = item.ItinerarioId }) |
                @Html.ActionLink("Editar", "Edit", new { id = item.ItinerarioId })
                @if (User.IsInRole("SuperUsuario"))
                {
                    <text> | </text>@Html.ActionLink("Eliminar", "Delete", new { id = item.ItinerarioId })
                }
            </td>
        </tr>
    }
</table>
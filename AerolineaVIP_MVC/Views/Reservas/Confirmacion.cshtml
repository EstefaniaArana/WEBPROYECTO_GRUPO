
@model AerolineaVIP_MVC.Models.Reserva
@{
    ViewBag.Title = "Confirmación de reserva";
    var filas = (List<AerolineaVIP_MVC.Controllers.AsignacionFila>)ViewBag.Filas;
    decimal total = (decimal)ViewBag.Total;
}

<h2>Reserva registrada</h2>

@if (TempData["Error"] != null)
{<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}

<div class="alert alert-success" role="alert">
    Su reserva <strong>@Model.CodigoReserva</strong> fue creada y está <strong>@Model.EstadoReservaCodigo.ToLower()</strong>.
</div>

<dl class="row">
    <dt class="col-sm-3">Código de reserva</dt>
    <dd class="col-sm-9">@Model.CodigoReserva</dd>
    <dt class="col-sm-3">Creada</dt>
    <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Vence</dt>
    <dd class="col-sm-9">@(Model.FechaExpiracion != null ? Model.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm") : "—")</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">USD @total.ToString("N2")</dd>
</dl>

<table class="table table-striped">
    <tr>
        <th>Pasajero</th>
        <th>Vuelo</th>
        <th>Asiento</th>
        <th>Importe (USD)</th>
        <th>Estado</th>
    </tr>
    @foreach (var f in filas)
    {
        <tr>
            <td>@f.Pasajero</td>
            <td>@f.Vuelo</td>
            <td>@f.Asiento</td>
            <td>@f.Importe.ToString("N2")</td>
            <td>@f.Estado</td>
        </tr>
    }
</table>

<div class="alert alert-info" role="alert">
    Sus asientos aparecen en <strong>morado (reservado)</strong> hasta que se pague. El pago simulado se habilita en el siguiente paso.
</div>

@Html.ActionLink("Mis reservas", "MisReservas", "Reservas", null, new { @class = "btn btn-primary" })
@Html.ActionLink("Buscar otro vuelo", "Buscar", "Vuelos", null, new { @class = "btn btn-outline-secondary" })
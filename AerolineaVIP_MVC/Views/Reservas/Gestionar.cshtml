@model AerolineaVIP_MVC.Models.Reserva
@{
    ViewBag.Title = "Gestión de la reserva";
    var filas = (List<AerolineaVIP_MVC.Controllers.AsignacionFila>)ViewBag.Filas;
    decimal total = (decimal)ViewBag.Total;
    bool puedeCancelar = (bool)ViewBag.PuedeCancelar;
    bool compraPagada = (bool)ViewBag.CompraPagada;
    string motivoNo = ViewBag.MotivoNoCancelar as string;
    string asientos = ViewBag.Asientos as string;
}

<h1 class="h2">Reserva @Model.CodigoReserva</h1>

@if (TempData["Error"] != null)
{<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
@if (TempData["Ok"] != null)
{<div class="alert alert-success" role="status">@TempData["Ok"]</div>}

<p>
    <span class="badge text-bg-primary">Reserva: @AerolineaVIP_MVC.Controllers.AyudaReservas.Bonito(Model.EstadoReservaCodigo)</span>
    <span class="badge text-bg-secondary">Compra: @ViewBag.EstadoCompra</span>
</p>

<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Pasajero</th><th>Vuelo</th><th>Asiento</th><th>Importe (USD)</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var f in filas)
            {
                <tr>
                    <td>@f.Pasajero</td>
                    <td>@f.Vuelo</td>
                    <td>@f.Asiento</td>
                    <td>@f.Importe.ToString("N2")</td>
                    <td>@AerolineaVIP_MVC.Controllers.AyudaReservas.Bonito(f.Estado)</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3">Total de la reserva</th><th colspan="2">USD @total.ToString("N2")</th></tr></tfoot>
    </table>
</div>

<div class="alert alert-info" role="status">
    Condiciones de cancelación y reembolso: <strong>pendientes de aprobación (DP-08)</strong>.
    @if (compraPagada)
    {<text> Si cancela, la compra y el pago simulado no se modifican.</text>}
</div>

@if (puedeCancelar)
{
    <h2 class="h5">Solicitar cancelación</h2>
    using (Html.BeginForm("CancelarReserva", "Reservas", new { id = Model.ReservaId }, FormMethod.Post, new { id = "formCancelar", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label for="motivo" class="form-label">Motivo de cancelación (opcional)</label>
            <textarea id="motivo" name="motivo" class="form-control" rows="3" maxlength="300" aria-describedby="ayuda_motivo err_motivo"></textarea>
            <div id="ayuda_motivo" class="form-text">Si lo escribe, debe tener entre 10 y 300 caracteres.</div>
            <div id="err_motivo" class="text-danger small" role="alert"></div>
        </div>
        <button type="submit" class="btn btn-danger">Solicitar cancelación</button>
    }
}
else if (motivoNo != null)
{
    <div class="alert alert-warning" role="alert">@motivoNo</div>
}

<p class="mt-3">
    @Html.ActionLink("Regresar a mis reservas", "MisReservas", "Reservas", null, new { @class = "btn btn-outline-secondary" })
    @if (Model.EstadoReservaCodigo == "PENDIENTE")
    {
        @Html.ActionLink("Pagar", "Pagar", "Compras", new { id = Model.ReservaId }, new { @class = "btn btn-success" })
    }
</p>

@* Modal de confirmación *@
<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="tituloCancelar" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tituloCancelar">Confirmar cancelación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                La cancelación liberará los asientos <strong>@asientos</strong>. Esta acción no se puede deshacer.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="btnNo">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnSi">Confirmar solicitud</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var modalElemento = document.getElementById('modalCancelar');
            var $form = $('#formCancelar');
            if ($form.length === 0) { return; }
            var modal = new bootstrap.Modal(modalElemento);

            // Al enviar: valida el motivo y abre el modal
            $form.on('submit', function (e) {
                e.preventDefault();
                var motivo = $.trim($('#motivo').val());
                if (motivo.length > 0 && (motivo.length < 10 || motivo.length > 300)) {
                    $('#err_motivo').text('El motivo debe tener entre 10 y 300 caracteres.');
                    $('#motivo').addClass('is-invalid').attr('aria-invalid', 'true').trigger('focus');
                    return;
                }
                $('#err_motivo').text('');
                $('#motivo').removeClass('is-invalid').removeAttr('aria-invalid');
                modal.show();
            });

            // Confirmar en el modal: se envía el formulario
            $('#btnSi').on('click', function () {
                $('#btnSi, #btnNo').prop('disabled', true);
                $('#btnSi').text('Procesando solicitud…');
                $form.get(0).submit();
            });
        });
    </script>
}

@model AerolineaVIP_MVC.Controllers.DatosReservaVista
@{
    ViewBag.Title = "Resumen de la reserva";
    var errores = ViewBag.Errores as List<string>;
}

<h1 class="h2">Resumen de la reserva</h1>

@if (errores != null && errores.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">@foreach (var e in errores)
        {<li>@e</li>}</ul>
    </div>
}

<h2 class="h5">Itinerario</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Tramo</th><th>Vuelo</th><th>Tarifa por pasajero (USD)</th></tr></thead>
        <tbody>
            @for (int i = 0; i < Model.Tramos.Count; i++)
            {
                <tr><td>@(i + 1)</td><td>@Model.Tramos[i].Texto</td><td>@Model.Tramos[i].Tarifa.ToString("N2")</td></tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5">Pasajeros y asientos</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Pasajero</th><th>Documento</th><th>Asientos</th><th>Importe (USD)</th></tr></thead>
        <tbody>
            @for (int i = 0; i < Model.Cantidad; i++)
            {
                var p = Model.Pasajeros[i];
                int pos = i;
                <tr>
                    <td>@p.Apellidos @p.Nombres</td>
                    <td>@p.TipoDocumentoCodigo @p.NumeroDocumento</td>
                    <td>@string.Join(" · ", Model.Tramos.Select(t => t.Asientos.First(a => a.NumeroAsiento == t.Elegidos[pos]).Codigo))</td>
                    <td>@Model.Tramos.Sum(t => t.Tarifa).ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot><tr><th colspan="3">Total estimado</th><th>USD @Model.Total.ToString("N2")</th></tr></tfoot>
    </table>
</div>

<div class="alert alert-info" role="status">
    Estado tras confirmar: <strong>Reserva pendiente de pago</strong>.
</div>

<div class="card mb-3">
    <div class="card-header"><strong>Condiciones de la reserva</strong></div>
    <div class="card-body">
        <ul class="mb-0">
            <li>La reserva se conserva 15 minutos (supuesto de implementación, DP-07). Si no se paga, expira y los asientos se liberan.</li>
            <li>Los asientos aparecen en morado (reservado) hasta que se pague.</li>
            <li>Las condiciones de cancelación y reembolso están pendientes de aprobación (DP-08).</li>
            <li>El pago es una simulación académica: no se realizan cobros reales.</li>
        </ul>
    </div>
</div>

@using (Html.BeginForm("Confirmar", "Reservas", FormMethod.Post, new { id = "formConfirmar" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="cantidad" value="@Model.Cantidad" />

    @* Se conservan los vuelos, los asientos y los datos de los pasajeros *@
    foreach (var t in Model.Tramos)
    {
        <input type="hidden" name="vuelos" value="@t.VueloId" />
        foreach (int n in t.Elegidos)
        {
            <input type="hidden" name="@("asientos_" + t.VueloId)" value="@n" />
        }
    }
    for (int i = 0; i < Model.Cantidad; i++)
    {
        var p = Model.Pasajeros[i];
        string prefijo = "pasajerosForm[" + i + "].";
        <input type="hidden" name="@(prefijo + "TipoDocumentoCodigo")" value="@p.TipoDocumentoCodigo" />
        <input type="hidden" name="@(prefijo + "NumeroDocumento")" value="@p.NumeroDocumento" />
        <input type="hidden" name="@(prefijo + "Nombres")" value="@p.Nombres" />
        <input type="hidden" name="@(prefijo + "Apellidos")" value="@p.Apellidos" />
        <input type="hidden" name="@(prefijo + "FechaNacimiento")" value="@(p.FechaNacimiento != null ? p.FechaNacimiento.Value.ToString("yyyy-MM-dd") : "")" />
        <input type="hidden" name="@(prefijo + "Correo")" value="@p.Correo" />
        <input type="hidden" name="@(prefijo + "Telefono")" value="@p.Telefono" />
    }

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="acepta" name="acepta" value="true" required aria-required="true" />
        <label class="form-check-label" for="acepta">Acepto las condiciones de la reserva *</label>
    </div>

    <button type="submit" name="accion" value="reservar" class="btn btn-primary">Confirmar reserva</button>
    <button type="submit" name="accion" value="pagar" class="btn btn-success">Confirmar y pagar</button>
    @Html.ActionLink("Volver a modificar", "SeleccionAsiento", "Reservas",
        new { id = Model.Tramos[0].VueloId, tramo2 = Model.Tramos.Count > 1 ? (int?)Model.Tramos[1].VueloId : null, pasajeros = Model.Cantidad },
        new { @class = "btn btn-outline-secondary" })
}

@section Scripts {
    <script>
        $(function () {
            // Evita envíos repetidos: se desactivan los botones DESPUÉS de que el navegador toma el valor de "accion"
            $('#formConfirmar').on('submit', function () {
                setTimeout(function () {
                    $('#formConfirmar button[type=submit]').prop('disabled', true);
                }, 0);
            });
            $(window).on('pageshow', function () {
                $('#formConfirmar button[type=submit]').prop('disabled', false);
            });
        });
    </script>
}

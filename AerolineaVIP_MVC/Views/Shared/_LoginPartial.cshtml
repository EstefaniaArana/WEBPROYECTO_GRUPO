@if (Request.IsAuthenticated)
{
    string rol = User.IsInRole("SuperUsuario") ? "SuperUsuario"
               : User.IsInRole("Administrador") ? "Administrador"
               : User.IsInRole("Cliente") ? "Cliente" : "Sin rol";

    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
        @Html.AntiForgeryToken()
        <ul class="nav navbar-nav navbar-right">
            <li><a href="#">Hola, @User.Identity.Name (@rol)</a></li>
            <li><a href="javascript:document.getElementById('logoutForm').submit()">Cerrar sesión</a></li>
        </ul>
    }
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li>@Html.ActionLink("Registrarse", "Register", "Account")</li>
        <li>@Html.ActionLink("Iniciar sesión", "Login", "Account")</li>
    </ul>
}
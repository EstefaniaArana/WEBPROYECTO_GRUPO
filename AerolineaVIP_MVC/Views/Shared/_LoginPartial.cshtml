@if (Request.IsAuthenticated)
{
    string rol = User.IsInRole("SuperUsuario") ? "SuperUsuario"
               : User.IsInRole("Administrador") ? "Administrador"
               : User.IsInRole("Cliente") ? "Cliente" : "Sin rol";

    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "ms-lg-auto" }))
    {
        @Html.AntiForgeryToken()
        <ul class="navbar-nav">
            <li class="nav-item"><span class="navbar-text me-lg-3">Hola, @User.Identity.Name (@rol)</span></li>
            <li class="nav-item">
                <a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()">Cerrar sesión</a>
            </li>
        </ul>
    }
}
else
{
    <ul class="navbar-nav ms-lg-auto">
        <li class="nav-item">@Html.ActionLink("Registrarse", "Register", "Account", null, new { @class = "nav-link" })</li>
        <li class="nav-item">@Html.ActionLink("Iniciar sesión", "Login", "Account", null, new { @class = "nav-link" })</li>
    </ul>
}
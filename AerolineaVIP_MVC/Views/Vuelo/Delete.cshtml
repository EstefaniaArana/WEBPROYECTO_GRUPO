@model AerolineaVIP_MVC.Models.Vuelo
@{
    ViewBag.Title = "Eliminar vuelo";
}

<h2>Eliminar vuelo</h2>
<h4>¿Seguro que desea eliminar este vuelo?</h4>

<dl class="dl-horizontal">
    <dt>Fecha</dt>
    <dd>@Model.FechaOperacion.ToString("dd/MM/yyyy")</dd>
    <dt>Ruta y horario</dt>
    <dd>@ViewBag.Ruta</dd>
    <dt>Estado</dt>
    <dd>@Model.EstadoVueloCodigo</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
}